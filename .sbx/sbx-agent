#!/usr/bin/env bash
set -uo pipefail

KIT_ROOT="$HOME/dotfiles/.sbx/kits"
AGENT="${1:-}"
shift || true

case "$AGENT" in
claude) KITS=(claude-defaults claude-statusline node-toolchain skills) ;;
codex) KITS=(codex-defaults codex-statusline node-toolchain skills) ;;
pi) KITS=(pi node-toolchain skills) ;;
*)
  echo "usage: sbx-agent {claude|codex|pi} [args...]"
  exit 2
  ;;
esac

# Canonical absolute path.
PROJECT_DIR="$(cd "$PWD" && pwd -P)"

# Human-readable project name.
PROJECT="$(basename "$PROJECT_DIR")"
PROJECT="$(
  printf '%s' "$PROJECT" |
    tr '[:upper:]_' '[:lower:]-' |
    tr -cd 'a-z0-9.-'
)"
PROJECT="${PROJECT:0:32}"
[[ -n "$PROJECT" ]] || PROJECT="project"

# Distinguish projects with the same basename at different absolute paths.
HASH="$(printf '%s' "$PROJECT_DIR" | cksum | awk '{print $1}')"
SANDBOX="${AGENT}-${PROJECT}-${HASH}"

# Do not mistake an unavailable daemon for a missing sandbox, or hide its error.
echo "→ Checking sandbox availability: $SANDBOX"
if SANDBOXES="$(sbx ls -q)"; then
  :
else
  STATUS=$?
  echo "Could not list sandboxes (exit $STATUS). Check sbx daemon status on the host." >&2
  exit "$STATUS"
fi

# Create project sandbox if this is the first run. Consume the entire list so
# an early grep match cannot cause a SIGPIPE under pipefail.
if ! grep -Fx "$SANDBOX" <<<"$SANDBOXES" >/dev/null; then
  echo "→ Creating $AGENT sandbox: $SANDBOX"

  KIT_ARGS=()
  for KIT in "${KITS[@]}"; do
    KIT_PATH="$KIT_ROOT/$KIT"
    if [[ ! -d "$KIT_PATH" ]]; then
      echo "Kit not found: $KIT_PATH" >&2
      exit 1
    fi
    sbx kit validate "$KIT_PATH" || exit $?
    # Register custom agents through --kit, then select their spec's name.
    # A kit path in the agent position requires sbx >= 0.42.
    KIT_ARGS+=(--kit "$KIT_PATH")
  done

  EXTRA_ARGS=()
  WORKSPACES=("$PROJECT_DIR")
  if [[ "$AGENT" == pi ]]; then
    VOICE_CACHE="$(python3 "$KIT_ROOT/pi/prepare-voice-model.py")" || exit $?
    EXTRA_ARGS+=(--env "SBX_PI_VOICE_CACHE=$VOICE_CACHE")
    WORKSPACES+=("$VOICE_CACHE:ro")
  fi

  sbx create \
    --name "$SANDBOX" \
    "${KIT_ARGS[@]}" \
    "${EXTRA_ARGS[@]}" \
    "$AGENT" \
    "${WORKSPACES[@]}" || exit $?

  # create returns before startup kits finish. For this newly created
  # container, wait for the latest dispatcher run before updating/launching.
  echo "→ Waiting for sandbox startup kits…"
  sbx exec "$SANDBOX" sh -c '
    log=/var/log/sbx-kit-startup.log
    attempts=0
    while [ "$attempts" -lt 300 ]; do
      state=$(awk '\''
        /^=== dispatcher run / { state = "running" }
        /^fail / { state = "failed" }
        /^=== dispatcher complete ===$/ { state = "complete" }
        END { print state }
      '\'' "$log" 2>/dev/null)
      case "$state" in
        complete) exit 0 ;;
        failed)
          echo "Startup kit failed:" >&2
          tail -n 40 "$log" >&2
          exit 1
          ;;
      esac
      attempts=$((attempts + 1))
      sleep 2
    done
    echo "Timed out after 10 minutes waiting for startup kits." >&2
    tail -n 40 "$log" >&2
    exit 1
  ' || exit $?
fi

# Update agent.
case "$AGENT" in
pi)
  echo "→ Checking Pi updates…"
  if sbx exec "$SANDBOX" sh -lc \
    'npm install -g --ignore-scripts --no-fund --no-audit --prefix /usr/local/share/npm-global @earendil-works/pi-coding-agent@latest'; then
    sbx exec "$SANDBOX" pi --version || exit $?
  else
    echo "⚠ Pi update failed; starting existing version."
  fi
  ;;
claude)
  BEFORE="$(
    sbx exec "$SANDBOX" claude --version 2>/dev/null |
      awk '{print $1}' |
      tail -1
  )"
  echo "→ Checking Claude Code updates (${BEFORE:-unknown})…"
  if sbx exec "$SANDBOX" claude update; then
    AFTER="$(
      sbx exec "$SANDBOX" claude --version 2>/dev/null |
        awk '{print $1}' |
        tail -1
    )"
    if [[ -n "$BEFORE" && -n "$AFTER" && "$BEFORE" != "$AFTER" ]]; then
      echo "✓ Claude Code updated: $BEFORE → $AFTER"
    else
      echo "✓ Claude Code is current (${AFTER:-$BEFORE})"
    fi
  else
    echo "⚠ Claude update check failed; starting existing version."
  fi
  ;;
codex)
  CURRENT="$(
    sbx exec "$SANDBOX" sh -lc \
      'codex --version 2>/dev/null | awk "{print \$NF}"' \
      2>/dev/null | tail -1
  )"
  echo "→ Checking Codex updates (${CURRENT:-unknown})…"
  LATEST="$(
    sbx exec "$SANDBOX" npm view @openai/codex version 2>/dev/null |
      tr -d '\r' |
      tail -1
  )"
  if [[ -z "$LATEST" ]]; then
    echo "⚠ Could not query latest Codex version; starting existing version."
  elif [[ "$CURRENT" == "$LATEST" ]]; then
    echo "✓ Codex is current ($CURRENT)"
  else
    echo "→ Updating Codex: ${CURRENT:-unknown} → $LATEST"
    if sbx exec -u root "$SANDBOX" \
      npm install -g "@openai/codex@$LATEST" --include=optional; then
      echo "✓ Codex updated to $LATEST"
    else
      echo "⚠ Codex update failed; starting existing version."
    fi
  fi
  ;;
esac

# Launch.
# Keep the launcher alive to repair terminal state if the interactive client
# exits without cleaning up. Leave stdin/stdout attached directly to the TTY.
TTY_STATE=""
if [[ -t 0 && -t 1 ]]; then
  TTY_STATE="$(stty -g)" || TTY_STATE=""
fi
finish() {
  local status=$?
  if [[ -n "$TTY_STATE" ]]; then
    stty "$TTY_STATE" || true
    # Leave alternate screen, reset attributes, show cursor, disable modes
    # that a crashed TUI can leave active in the parent shell.
    printf '\033[?1049l\033[0m\033[?25h\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l'
  fi
  if ((status != 0)); then
    echo "$AGENT session exited with status $status ($SANDBOX)." >&2
    echo "If other sbx commands also hang, check the host sandbox daemon." >&2
  fi
  trap - EXIT
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
echo "→ Starting $AGENT in $SANDBOX"
echo
if [[ "$AGENT" == pi ]]; then
  # The custom-agent sbx run path can exit before Pi's harness opens.
  # Launch directly with stdin and a terminal, as needed for /login.
  EXEC_FLAGS=(-i)
  [[ -t 0 && -t 1 ]] && EXEC_FLAGS=(-it)
  sbx exec "${EXEC_FLAGS[@]}" -w "$PROJECT_DIR" "$SANDBOX" pi "$@"
elif (($# > 0)); then
  sbx run --name "$SANDBOX" -- "$@"
else
  sbx run --name "$SANDBOX"
fi
exit $?
