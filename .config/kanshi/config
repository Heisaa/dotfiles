# Monitor layouts for sway and mango (both start kanshi). External monitors
# are matched by "make model serial", not by port name: the dock hands out a
# different DP-N on every connect. eDP-1 is the built-in panel and keeps its name.
# Get the strings with: wlr-randr
# transform counts counterclockwise, as wlr-randr prints it (sway's "270" is "90").

profile docked {
    output "Dell Inc. DELL P2422HE BPFBYB3" mode 1920x1080@60Hz position 0,0 scale 1
    output "Dell Inc. DELL P2419HC 7QBPJ73" mode 1920x1080@60Hz position 1920,0 scale 1 transform 90
    output eDP-1 mode 2880x1800@120.001Hz position 0,1080 scale 1.5
}

profile laptop {
    output eDP-1 mode 2880x1800@120.001Hz position 0,0 scale 1.5
}
