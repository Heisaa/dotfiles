{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowAllUnixSockets": true,
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "gitlab.com",
        "bitbucket.org",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",
        "crates.io",
        "*.crates.io",
        "static.rust-lang.org",
        "docs.rs",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "dl.google.com",
        "maven.google.com",
        "repo1.maven.org",
        "*.gradle.org",
        "*.docker.io",
        "production.cloudflare.docker.com",
        "huggingface.co",
        "*.huggingface.co",
        "aur.archlinux.org",
        "*.archlinux.org",
        "*.pkgbuild.com",
        "mirrors.kernel.org",
        "api.anthropic.com"
      ],
      "strictAllowlist": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/tmp/.X11-unix"
      ],
      "denyRead": [
        "~/.claude/projects"
      ],
      "allowRead": [
        "~/.claude/projects/-home-hsa-dotfiles/memory"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.zsh_history",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "DATABASE_URL",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "light",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
